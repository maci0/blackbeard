# Stage 1: Build
# Pin tag + multi-arch index digest for reproducible base layers.
FROM oven/bun:1.4.0-alpine@sha256:07235578f79ef8c6f97d94aee7938e76f5cdba5f21ae5dbfdd3d3d38058437eb AS build
WORKDIR /app
# Optional: pass --build-arg SOURCE_DATE_EPOCH=$(git log -1 --pretty=%ct) for
# bit-for-bit stable asset hashes when tooling honors it.
ARG SOURCE_DATE_EPOCH=0
ENV SOURCE_DATE_EPOCH=${SOURCE_DATE_EPOCH} \
    TZ=UTC \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    NODE_ENV=production
COPY package.json bun.lock ./
RUN --mount=type=cache,target=/root/.bun/install/cache \
    bun install --frozen-lockfile
COPY . .
# NOTE: Do NOT bake VITE_API_KEY into the image, it would expose the API key
# in the client JS bundle. In production, users authenticate via JWT (login flow).
# For local dev, set VITE_API_KEY in frontend/.env.local.
RUN bun run build

# Stage 2: Serve with nginx (patch + digest pinned for reproducible base layers).
FROM nginxinc/nginx-unprivileged:1.31.3-alpine@sha256:f972e5322b9797dc2a6b830030094426437b1ae7032e4644496395336ac6fdac
LABEL org.opencontainers.image.source="https://github.com/blackbeard" \
      org.opencontainers.image.title="blackbeard-ui" \
      org.opencontainers.image.description="Blackbeard Agent Management Platform: UI"
# Base digests lag Alpine security fixes (curl/openssl/expat/c-ares/libxml2).
# Upgrade OS packages so Trivy CRITICAL/HIGH scans pass; drop this once the
# pinned nginx image ships those fixes and re-pin its digest.
USER root
RUN apk upgrade --no-cache
USER 101
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/templates/default.conf.template
COPY security-headers.conf /etc/nginx/security-headers.conf
ENV API_UPSTREAM=api:8000
EXPOSE 3000
STOPSIGNAL SIGQUIT
HEALTHCHECK --interval=10s --timeout=5s --retries=3 --start-period=5s \
  CMD wget --no-verbose --tries=1 --spider http://localhost:3000/ || exit 1
CMD ["nginx", "-g", "daemon off;"]
