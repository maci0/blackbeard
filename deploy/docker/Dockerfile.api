FROM python:3.13-slim
LABEL org.opencontainers.image.source="https://github.com/blackbeard" \
      org.opencontainers.image.title="blackbeard-api" \
      org.opencontainers.image.description="Blackbeard Agent Management Platform — API"
WORKDIR /app
ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

RUN adduser --disabled-password --gecos "" --shell /usr/sbin/nologin --uid 10001 appuser

COPY pyproject.toml uv.lock ./
RUN --mount=type=cache,target=/root/.cache/uv \
    --mount=from=ghcr.io/astral-sh/uv:0.11.15,source=/uv,target=/usr/local/bin/uv \
    uv sync --no-install-project --no-dev --frozen

COPY . .
RUN --mount=type=cache,target=/root/.cache/uv \
    --mount=from=ghcr.io/astral-sh/uv:0.11.15,source=/uv,target=/usr/local/bin/uv \
    uv sync --no-editable --no-dev --frozen \
    && chmod +x entrypoint.sh
USER appuser
ENV HOME=/home/appuser
EXPOSE 8000
STOPSIGNAL SIGTERM
HEALTHCHECK --interval=10s --timeout=5s --retries=10 --start-period=120s \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/api/v1/health/ready')"
CMD ["./entrypoint.sh"]
