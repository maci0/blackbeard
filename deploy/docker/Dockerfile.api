# Pin patch-level tag + digest for reproducible base layers (dependabot can bump).
FROM python:3.13.14-slim@sha256:6771159cd4fa5d9bba1258caf0b82e6b73458c694d178ad97c5e925c2d0e1a91
LABEL org.opencontainers.image.source="https://github.com/blackbeard" \
      org.opencontainers.image.title="blackbeard-api" \
      org.opencontainers.image.description="Blackbeard Agent Management Platform — API"
# Pass --build-arg SOURCE_DATE_EPOCH=$(git log -1 --pretty=%ct) for stable metadata.
ARG SOURCE_DATE_EPOCH=0
ENV SOURCE_DATE_EPOCH=${SOURCE_DATE_EPOCH} \
    TZ=UTC \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    PYTHONHASHSEED=0 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/app/.venv/bin:$PATH"
WORKDIR /app

RUN adduser --disabled-password --gecos "" --shell /usr/sbin/nologin --uid 10001 appuser

COPY pyproject.toml uv.lock ./
# uv binary pinned by tag + multi-arch index digest (matches CI UV_VERSION).
RUN --mount=type=cache,target=/root/.cache/uv \
    --mount=from=ghcr.io/astral-sh/uv:0.11.15@sha256:e590846f4776907b254ac0f44b5b380347af5d90d668138ca7938d1b0c2f98d3,source=/uv,target=/usr/local/bin/uv \
    uv sync --no-install-project --no-dev --frozen

COPY . .
RUN --mount=type=cache,target=/root/.cache/uv \
    --mount=from=ghcr.io/astral-sh/uv:0.11.15@sha256:e590846f4776907b254ac0f44b5b380347af5d90d668138ca7938d1b0c2f98d3,source=/uv,target=/usr/local/bin/uv \
    uv sync --no-editable --no-dev --frozen \
    && chmod +x entrypoint.sh
USER appuser
ENV HOME=/home/appuser
EXPOSE 8000
STOPSIGNAL SIGTERM
HEALTHCHECK --interval=10s --timeout=5s --retries=10 --start-period=120s \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/api/v1/health/ready')"
CMD ["./entrypoint.sh"]
