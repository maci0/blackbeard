# ── Blackbeard API ────────────────────────────────────────────────────────────
# true = local development (allows insecure example defaults below).
# false = production: API refuses to start with example secrets/passwords.
# For production: set DEBUG=false and replace every secret/password in this file.
DEBUG=true

# Default admin password for development. Only used when DEBUG=true.
# If unset, run.sh defaults to "Blackbeard1". Change or unset for production.
# BLACKBEARD_ADMIN_PASSWORD=Blackbeard1

# Used for X-API-Key header authentication on all API endpoints.
# Change this to a strong random value before deploying (required when DEBUG=false).
BLACKBEARD_API_KEY=change-me-in-production

# ── RBAC ──────────────────────────────────────────────────────────────────────
# Enable Role-Based Access Control. When false (default), all authenticated
# users have full access. Set to true for production and configure
# Role/RoleBinding resources via seed.sh or YAML import.
# ENFORCE_RBAC=false
#
# Open self-registration (POST /auth/register). When DEBUG=false the API
# refuses to start if registration is open AND ENFORCE_RBAC is false
# (that combination lets anyone self-register with full access).
# ALLOW_REGISTRATION=true

# ── Database (PostgreSQL container) ───────────────────────────────────────────
# Credentials used by the PostgreSQL container itself.
# Change these to strong values before deploying.
POSTGRES_USER=blackbeard
POSTGRES_PASSWORD=blackbeard
POSTGRES_DB=blackbeard

# ── Database (API server) ─────────────────────────────────────────────────────
# asyncpg DSN used by SQLAlchemy async engine inside the FastAPI process.
# The embedded host 'postgres' refers to the postgres service in docker-compose.
# Must match POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB above.
DATABASE_URL=postgresql+asyncpg://blackbeard:blackbeard@postgres:5432/blackbeard

# ── Valkey (Redis-compatible cache) ────────────────────────────────────────────
# The embedded host 'valkey' refers to the valkey service in docker-compose.
VALKEY_URL=valkey://default:valkey-dev-secret@valkey:6379/0
# Password used by the Valkey container itself. Must match the password in VALKEY_URL.
VALKEY_PASSWORD=valkey-dev-secret

# ── LiteLLM Proxy ─────────────────────────────────────────────────────────────
# Master key must match general_settings.master_key in deploy/litellm/config.yaml.
LITELLM_MASTER_KEY=sk-litellm-master-key
# URL the API server uses to reach the LiteLLM proxy (internal docker network).
LITELLM_PROXY_URL=http://litellm:4000
# DSN for LiteLLM's own database. Must match POSTGRES_USER/PASSWORD above.
# LITELLM_DATABASE_URL=postgresql://blackbeard:blackbeard@postgres:5432/litellm

# ── Langfuse (observability / tracing) ────────────────────────────────────────
# Optional. Langfuse provides LLM observability, tracing, and cost tracking.
# The initdb script creates a 'langfuse' database automatically. Deploy the
# Langfuse container separately or point at an external instance.
# LANGFUSE_HOST=http://langfuse-web:3000
# Obtain these from Langfuse Settings → API Keys after first login.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=

# ── GCP / Vertex AI credentials ───────────────────────────────────────────────
# Google Cloud project that hosts Vertex AI (Anthropic + Gemini models).
# Leave unset to run without Vertex AI models.
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# Vertex AI region (check Google Cloud docs for model availability per region).
CLOUD_ML_REGION=us-east5
# Leave empty to use GCP Workload Identity or Application Default Credentials.
# To use a service-account JSON key, mount it into the api and litellm
# containers (e.g. via docker-compose.override.yaml volumes) and set this
# to the *container-internal* path (e.g. /secrets/gcp-key.json).
# GOOGLE_APPLICATION_CREDENTIALS=

# ── JWT Authentication ────────────────────────────────────────────────────────
# Secret key used to sign and verify JWT access/refresh tokens.
# Change this to a strong random value before deploying.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=change-jwt-secret-in-production!

# ── Server ────────────────────────────────────────────────────────────────────
# Trusted proxy IPs for X-Forwarded-For headers. Default '127.0.0.1' trusts only localhost.
# In production behind a known proxy, set to its IP (e.g., '172.18.0.0/16').
# WARNING: Setting to '*' trusts ALL sources, allowing IP spoofing that bypasses rate limiting.
# FORWARDED_ALLOW_IPS=127.0.0.1
# CORS origins (JSON array). Default: ["http://localhost:3000","http://localhost:5173"]
# Set to your domain in production (must use https:// when DEBUG=false).
# CORS_ORIGINS=["https://your-domain.com"]
# Log level for the API server (case-insensitive).
# Options: debug, info, warning, error, critical. Default: info (debug when DEBUG=true).
# LOG_LEVEL=info
# Number of uvicorn workers. Default: 1. Set to CPU count for production.
# WEB_CONCURRENCY=4

# ── Database pool ─────────────────────────────────────────────────────────────
# Connection pool tuning for the async SQLAlchemy engine.
# DB_POOL_SIZE=10
# DB_POOL_MAX_OVERFLOW=20
# DB_POOL_TIMEOUT=30
# DB_POOL_RECYCLE=3600
# Log queries slower than N seconds / pool checkouts held longer than N seconds.
# DB_SLOW_QUERY_THRESHOLD_S=1.0
# DB_LONG_CHECKOUT_THRESHOLD_S=5.0

# ── Execution concurrency ─────────────────────────────────────────────────────
# Number of parallel crew executions the API server will run simultaneously.
# MAX_CONCURRENT_EXECUTIONS=4
# Maximum concurrent SSE (Server-Sent Events) connections for execution streaming.
# MAX_CONCURRENT_SSE=20
# Stable identity of this API instance, used to scope startup execution
# recovery in multi-replica deployments. Defaults to the container hostname;
# set explicitly when the platform does not keep hostnames stable across
# restarts (e.g. Kubernetes Deployments).
# BLACKBEARD_WORKER_ID=api-1

# ── Data retention ────────────────────────────────────────────────────────────
# Automatic purge of aged personal data (GDPR storage limitation).
# Unset = keep forever. Audit logs are deleted after N days; finished
# executions (inputs/outputs) after N days; deactivated (soft-deleted) users
# are hard-deleted after N days. Checked every 6 hours.
# AUDIT_LOG_RETENTION_DAYS=365
# EXECUTION_RETENTION_DAYS=90
# USER_RETENTION_DAYS=30

# ── Rate limiting ────────────────────────────────────────────────────────────
# Auth failure rate limiting (per IP). Limits brute-force login attempts.
# AUTH_FAIL_WINDOW_SECONDS=300
# AUTH_FAIL_MAX_PER_IP=20
# AUTH_FAIL_MAX_TRACKED_IPS=200

# ── JWT session tuning ───────────────────────────────────────────────────────
# Access token lifetime (minutes) and refresh token lifetime (days).
# JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
# JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── SSRF protection ──────────────────────────────────────────────────────────
# Set to true to disable URL SSRF checks. Only for local dev with Ollama, etc.
# WARNING: Disabling SSRF checks in production allows resource specs to reference
# internal IPs (169.254.x.x, 10.x.x.x, etc.), enabling server-side request forgery.
# ALLOW_INTERNAL_URLS=false

# ── Plugin directory ─────────────────────────────────────────────────────────
# Directory scanned for Python plugin modules at startup.
# PLUGIN_DIR=plugins

# ── Sandbox ───────────────────────────────────────────────────────────────────
# Container runtime for sandbox execution: "auto", "docker", or "podman".
# CONTAINER_RUNTIME=auto
# Default image, per-run timeout (seconds), and memory limit (e.g. 256m, 1g)
# for container-sandboxed tools.
# CONTAINER_DEFAULT_IMAGE=python:3.13-slim
# CONTAINER_TIMEOUT=30
# CONTAINER_MEMORY_LIMIT=256m
# Enable the gVisor (runsc) sandbox tier.
# GVISOR_ENABLED=false
# Enable Firecracker/libkrun MicroVM sandbox tier (requires /dev/kvm).
# MICROVM_ENABLED=false
# Firecracker backend for the microvm tier. Kernel and rootfs must be set
# together; when unset, the microvm tier falls back to libkrun.
# FIRECRACKER_BIN=firecracker
# FIRECRACKER_KERNEL=/var/lib/firecracker/vmlinux.bin
# FIRECRACKER_ROOTFS=/var/lib/firecracker/rootfs.ext4

# ── Temporal workflow engine (optional) ──────────────────────────────────────
# When TEMPORAL_HOST is set, crew executions run as durable Temporal workflows
# instead of ThreadPoolExecutor threads. See docker-compose.temporal.yaml.
# TEMPORAL_HOST=temporal:7233
# TEMPORAL_NAMESPACE=blackbeard
# TEMPORAL_TASK_QUEUE=crew-execution
# TEMPORAL_WORKFLOW_TIMEOUT_S=3600

# ── MuninnDB cognitive memory (optional) ─────────────────────────────────────
# Base URL of a MuninnDB instance for agent memory backends.
# MUNINNDB_URL=http://localhost:8475

# ── OpenTelemetry (optional) ──────────────────────────────────────────────────
# Set to enable OTLP trace export for execution events.
# OTEL_ENDPOINT=http://otel-collector:4317

# ── OIDC / SSO (optional) ─────────────────────────────────────────────────────
# Any OIDC provider works: Google, Azure AD, Okta, Keycloak, Authentik.
# Set OIDC_ISSUER to enable "Sign in with SSO" on the login page.
# OIDC_ISSUER=https://auth.company.com/realms/main
# OIDC_CLIENT_ID=blackbeard
# OIDC_CLIENT_SECRET=your-client-secret
# OIDC_REDIRECT_URI=http://localhost:8000/api/v1/auth/oidc/callback
# OIDC_SCOPES=openid email profile

# ── Startup ───────────────────────────────────────────────────────────────────
# Timeout in seconds for database migration step during container startup.
# MIGRATION_TIMEOUT=120
