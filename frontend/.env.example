# ── Frontend Environment Variables ────────────────────────────────────────────
# These are build-time Vite env vars (prefixed with VITE_).

# API key for X-API-Key header authentication during local dev (bun run dev).
# In Docker production, nginx injects the key server-side.
# VITE_API_KEY=your-dev-api-key

# Override API base URL when hosting frontend on a different origin than the API.
# Not needed for local dev (Vite proxy) or Docker (nginx proxy).
# VITE_API_BASE_URL=http://localhost:8000
