{
  "name": "@blackbeard/react",
  "version": "0.2.0",
  "description": "Embeddable React components for Blackbeard Agent Management Platform",
  "type": "module",
  "packageManager": "bun@1.2.17",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {},
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.1.0",
    "jsdom": "^29.1.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.7"
  },
  "engines": {
    "bun": ">=1.2.17",
    "node": ">=18"
  },
  "sideEffects": false,
  "files": ["dist", "src"],
  "license": "MIT"
}
