{
  "name": "blackbeard-sdk",
  "version": "0.3.0",
  "description": "TypeScript SDK for Blackbeard Agent Management Platform",
  "type": "module",
  "packageManager": "bun@1.2.17",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {},
  "devDependencies": {
    "typescript": "^5.8.0",
    "vitest": "^4.1.7"
  },
  "engines": {
    "bun": ">=1.2.17",
    "node": ">=18"
  },
  "sideEffects": false,
  "files": ["dist", "src"],
  "license": "MIT"
}
